	fragment@58 {
		target = <0xffffffff>;

		__overlay__ {

			fingerprint_reset_high {
				phandle = <0x48>;

				mux {
					pins = "gpio111";
					function = "gpi111";
				};

				config {
					pins = "gpio111";
					drive-strength = <0x02>;
					bias-disable;
					output-high;
				};
			};

			fingerprint_reset_low {
				phandle = <0x49>;

				mux {
					pins = "gpio111";
					function = "gpio";
				};

				config {
					pins = "gpio111";
					drive-strength = <0x02>;
					bias-disable;
					output-low;
				};
			};

			fingerprint_irq_default {
				phandle = <0x4a>;

				mux {
					pins = "gpio85";
					function = "gpio";
				};

				config {
					pins = "gpio85";
					drive-strength = <0x02>;
					bias-pull-down;
				};
			};

			syna_tcm_eint_init {
				phandle = <0x54>;

				mux {
					pins = "gpio162";
					function = "gpio";
				};

				config {
					pins = "gpio162";
					bias-disable;
					input-enable;
				};
			};

			syna_tcm_rst_init {
				phandle = <0x55>;

				mux {
					pins = "gpio161";
					function = "gpio";
				};

				config {
					pins = "gpio161";
					bias-disable;
					output-low;
				};
			};

			syna_tcm_eint_suspend {
				phandle = <0x56>;

				mux {
					pins = "gpio162";
					function = "gpio";
				};

				config {
					pins = "gpio162";
					bias-pull-down;
				};
			};

			syna_tcm_rst_suspend {
				phandle = <0x57>;

				mux {
					pins = "gpio161";
					function = "gpio";
				};

				config {
					pins = "gpio161";
					bias-pull-down;
					output-low;
				};
			};

			mi_ts_spi_miso_active {
				phandle = <0x4f>;

				mux {
					pins = "gpio40";
					function = "qup1_se2_l0";
				};

				config {
					pins = "gpio40";
					drive-strength = <0x06>;
					bias-pull-down;
				};
			};

			mi_ts_spi_mosi_active {
				phandle = <0x4e>;

				mux {
					pins = "gpio41";
					function = "qup1_se2_l1";
				};

				config {
					pins = "gpio41";
					drive-strength = <0x06>;
					bias-pull-down;
				};
			};

			mi_ts_spi_clk_active {
				phandle = <0x50>;

				mux {
					pins = "gpio42";
					function = "qup1_se2_l2";
				};

				config {
					pins = "gpio42";
					drive-strength = <0x06>;
					bias-pull-down;
				};
			};

			mi_ts_spi_cs_active {
				phandle = <0x51>;

				mux {
					pins = "gpio43";
					function = "qup1_se2_l3";
				};

				config {
					pins = "gpio43";
					drive-strength = <0x06>;
					bias-pull-down;
				};
			};

			mi_ts_spi_cs_sleep {
				phandle = <0x53>;

				mux {
					pins = "gpio43";
					function = "gpio";
				};

				config {
					pins = "gpio43";
					drive-strength = <0x06>;
					bias-pull-up;
				};
			};

			mi_ts_spi_sleep {
				phandle = <0x52>;

				mux {
					pins = "gpio40\0gpio41\0gpio42";
					function = "gpio";
				};

				config {
					pins = "gpio40\0gpio41\0gpio42";
					drive-strength = <0x02>;
					bias-pull-down;
				};
			};

			t1_gpio_ctl {
				phandle = <0x4b>;

				mux {
					pins = "gpio201\0gpio172";
					function = "gpio";
				};

				config {
					pins = "gpio201\0gpio172";
					drive-strength = <0x02>;
					bias-disable;
					output-enable;
				};
			};
		};
	};

